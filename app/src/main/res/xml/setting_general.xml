<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/setting_general_display">
        <ListPreference
            android:key="color_scheme"
            android:title="@string/setting_general_display_color_scheme"
            android:entries="@array/setting_general_display_color_scheme_entries"
            android:entryValues="@array/setting_general_display_color_scheme_values"
            android:dialogTitle="@string/setting_general_display_color_scheme"
            android:defaultValue="1"/>
        <ListPreference
            android:key="language"
            android:title="@string/setting_general_display_language"
            />
    </PreferenceCategory>
</PreferenceScreen>