<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FXbox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorPrimaryVariant">@color/theme_black_red_dark</item>
        <item name="colorOnPrimary">@color/colorAccent</item>
        <item name="android:textCursorDrawable">@drawable/edittext_cursor_drw</item>
        <item name="android:windowBackground">@null</item>
        <item name="android:progressTint">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:buttonTint">@color/colorAccent</item>
        <item name="android:textDirection">ltr</item>
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:supportsRtl">false</item>
    </style>
    <style name="SlideAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_vertical</item>
        <item name="android:windowExitAnimation">@anim/slide_out_vertical</item>
    </style>
    <style name="ThemeOverlay.FXbox.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>
    </style>

    <!-- Define a style for the tab text -->
    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">13.8sp</item>
        <item name="fontFamily">@font/red_hat_text_bold</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:shadowDx">-1</item>
        <item name="android:shadowDy">-1</item>
        <item name="android:shadowRadius">2</item>
        <item name="android:shadowColor">@color/rgb_84</item>
    </style>

    <style name="MyToolbarTitleTextAppearance" parent="Widget.Material3.Toolbar">
        <!-- Đặt kích thước chữ cho tiêu đề -->
        <item name="android:fontFamily">@font/tiktok_text_medium</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="ToolbarTitleTextAppearance" parent="Widget.Material3.Toolbar">
        <!-- Đặt kích thước chữ cho tiêu đề -->
        <item name="android:fontFamily">@font/tiktok_display_bold</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>