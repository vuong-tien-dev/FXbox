<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shorts_item_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <com.google.android.exoplayer2.ui.AspectRatioFrameLayout
        android:id="@+id/shorts_video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true">

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/shorts_player_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:resize_mode="fixed_width"
            app:use_controller="false" />

        <ImageView
            android:id="@+id/shorts_video_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:ignore="ContentDescription" />

        <FrameLayout
            android:id="@+id/shorts_img_list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/shorts_ic_play"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:alpha="0.8"
            android:visibility="gone"
            app:srcCompat="@drawable/shorts_play"
            app:tint="@color/white_a60"
            tools:ignore="ContentDescription" />
    </com.google.android.exoplayer2.ui.AspectRatioFrameLayout>

    <com.bosphere.fadingedgelayout.FadingEdgeLayout
        android:id="@+id/shorts_description_fading_edge"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_background_drw" />

    <include
        android:id="@+id/shorts_contents"
        layout="@layout/shorts_contents_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>