<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/video_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="@drawable/download_item_background"
    android:clickable="true"
    android:padding="4dp"
    android:paddingStart="20dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/download_item_thumbnail_container"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/download_item_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
             />
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/download_cancel"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/search_bar_view_delete_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/download_item_name"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/download_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="marquee"
        android:fontFamily="@font/tiktok_display_bold"
        android:maxLines="1"
        android:text="name_video"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:layout_constraintEnd_toStartOf="@+id/download_cancel"
        app:layout_constraintStart_toEndOf="@+id/download_item_thumbnail_container"
        app:layout_constraintTop_toTopOf="@+id/download_item_thumbnail_container"
        tools:ignore="EllipsizeMaxLines" />

    <TextView
        android:id="@+id/download_item_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:fontFamily="@font/gotham_bold"
        android:maxLength="20"
        android:maxLines="1"
        android:textColor="@color/rgb_180"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/download_status_container"
        app:layout_constraintStart_toStartOf="@+id/download_item_name"
        app:layout_constraintTop_toBottomOf="@+id/download_item_name" />

    <TextView
        android:id="@+id/download_item_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/gotham_bold"
        android:textColor="@color/rgb_145"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/download_item_author"
        app:layout_constraintStart_toEndOf="@+id/download_item_author"
        app:layout_constraintTop_toTopOf="@+id/download_item_author" />

    <FrameLayout
        android:id="@+id/download_status_container"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/download_resume_or_pause"
        app:layout_constraintEnd_toStartOf="@+id/download_resume_or_pause"
        app:layout_constraintStart_toStartOf="@+id/download_item_name"
        app:layout_constraintTop_toTopOf="@+id/download_resume_or_pause">

        <ProgressBar
            android:id="@+id/download_progress_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/download_status_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/download_is_waiting" />
    </FrameLayout>

    <ImageView
        android:id="@+id/download_resume_or_pause"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="45dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/pause"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>