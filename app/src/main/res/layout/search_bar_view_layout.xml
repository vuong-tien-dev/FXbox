<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/rgb_34">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/searchBarContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/search_bar_back_icon"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:visibility="invisible"
        android:src="@drawable/search_bar_view_back_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white_240" />

    <EditText
        android:id="@+id/search_bar_editor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:visibility="invisible"
        android:fontFamily="@font/tiktok_display_medium"
        android:hint="@string/search"
        android:padding="4dp"
        android:singleLine="true"
        android:maxLines="1"
        android:inputType="text"
        android:textSize="14.8sp"
        android:imeOptions="actionSearch"
        android:textColor="@color/white_240"
        android:textColorHint="@color/rgb_145"
        android:textCursorDrawable="@drawable/edittext_cursor_drw"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/search_bar_delete_or_search_icon"
        app:layout_constraintStart_toEndOf="@+id/search_bar_back_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/search_bar_delete_or_search_icon"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="8dp"
        android:padding="10dp"
        android:src="@drawable/shorts_search_bar_drw"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white_240" />

</androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>