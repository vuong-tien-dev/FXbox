<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/playlist_name_edt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/base_edit_text_background"
        android:fontFamily="@font/red_hat_text_medium"
        android:hint="@string/enter_playlist_name"
        android:padding="6dp"
        android:textColor="@color/white"
        android:textColorHint="@color/rgb_230"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/playlist_desc_edt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/base_edit_text_background"
        android:fontFamily="@font/red_hat_text_medium"
        android:hint="@string/enter_playlist_desc"
        android:padding="6dp"
        android:textColor="@color/white"
        android:textColorHint="@color/rgb_230"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/playlist_name_edt"
        app:layout_constraintStart_toStartOf="@+id/playlist_name_edt"
        app:layout_constraintTop_toBottomOf="@+id/playlist_name_edt" />
</androidx.constraintlayout.widget.ConstraintLayout>