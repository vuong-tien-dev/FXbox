<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:id="@+id/shorts_item_parent"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/shorts_video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="UselessParent">

        <com.vtstudio.fxbox.fxviews.listview.ImagePagerView
            android:id="@+id/shorts_image_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/shorts_video_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:ignore="ContentDescription" />
        <ImageView
            android:id="@+id/shorts_ic_play"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:alpha="0.8"
            android:visibility="gone"
            app:srcCompat="@drawable/shorts_play"
            app:tint="@color/white_a60"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <com.bosphere.fadingedgelayout.FadingEdgeLayout
        android:id="@+id/shorts_description_fading_edge"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/gradient_background_drw"
        android:layout_gravity="bottom"/>

    <include
        android:id="@+id/shorts_contents"
        layout="@layout/shorts_contents_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>