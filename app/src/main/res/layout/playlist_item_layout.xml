<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground">

    <androidx.cardview.widget.CardView
        android:id="@+id/playlist_thumbnail_wrapper"
        android:layout_width="160dp"
        android:layout_height="90dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/playlist_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
            <TextView
                android:layout_gravity="bottom"
                android:id="@+id/playlist_item_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white_240"
                android:fontFamily="@font/tiktok_text_medium"
                android:textSize="12sp"
                android:text="0 video"
                android:drawableStart="@drawable/library_playlist_icon"
                android:background="@color/black_a40"
                android:gravity="center" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/playlist_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="marquee"
        android:maxLines="1"
        android:text="name of list"
        android:textColor="@color/white_240"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@+id/playlist_more_icon"
        app:layout_constraintStart_toStartOf="@+id/playlist_thumbnail_wrapper"
        app:layout_constraintTop_toBottomOf="@+id/playlist_thumbnail_wrapper" />

    <ImageView
        android:id="@+id/playlist_more_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:scaleType="centerCrop"
        android:src="@drawable/more_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/playlist_thumbnail_wrapper" />
</androidx.constraintlayout.widget.ConstraintLayout>