<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_layout_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true"
    tools:context=".activity.PlayVideo">

    <FrameLayout
        android:id="@+id/ac_play_video_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top">

        <com.vtstudio.fxbox.fxviews.listview.FxRecyclerView
            android:id="@+id/ac_play_video_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ac_play_video_back_ic"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/search_bar_view_back_icon"
                app:tint="@color/rgb_240" />

            <com.vtstudio.fxbox.fxviews.textview.TextExtraView
                android:id="@+id/ac_play_video_search_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="24dp"
                android:alpha="85"
                android:fontFamily="@font/roboto_medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:shadowColor="@color/rgb_145"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:text="@string/enter_search_content"
                android:textColor="@color/white_240"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@+id/ac_play_video_back_ic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ac_play_video_back_ic"
                app:layout_constraintTop_toTopOf="@+id/ac_play_video_back_ic"
                app:textExtra="@string/search" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/ac_current_playing_position_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:fontFamily="@font/gotham_bold"
        android:maxLines="1"
        android:padding="4dp"
        android:shadowDx="1"
        android:shadowDy="1"
        android:textColor="@color/white_a85"
        android:textSize="15sp"
        android:visibility="invisible" />

    <FrameLayout
        android:id="@+id/ac_play_video_bottom_sheet_wrapper"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:paddingVertical="6dp"
        android:paddingHorizontal="6dp"
        android:layout_gravity="bottom">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ac_play_video_bottom_sheet_lay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/link_edittext_bg">
            <ImageView
                android:id="@+id/ac_play_video_list_ic"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="18dp"
                android:src="@drawable/playlist"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/ac_play_video_name_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:ellipsize="marquee"
                android:fadingEdge="none"
                android:fontFamily="@font/roboto_medium"
                android:gravity="start"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:scrollbars="none"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:textColor="@color/rgb_210"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@+id/ac_play_video_list_ic"
                app:layout_constraintStart_toEndOf="@+id/ac_play_video_list_ic"
                app:layout_constraintTop_toTopOf="@+id/ac_play_video_list_ic" />

            <TextView
                android:id="@+id/ac_play_video_percent_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:fontFamily="@font/red_hat_text_bold"
                android:textColor="@color/colorWhite"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@+id/ac_play_video_list_ic"
                app:layout_constraintStart_toEndOf="@+id/ac_play_video_name_list"
                app:layout_constraintTop_toTopOf="@+id/ac_play_video_list_ic" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <com.vtstudio.fxbox.fxviews.progressbar.FxExoSeekBar
        android:id="@+id/ac_play_video_exo_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="46dp"
        android:paddingStart="0dp"
        android:paddingTop="10dp"
        android:paddingEnd="0dp"
        android:paddingBottom="0dp"
        app:activeDrawable="@drawable/active_tracking_effect"
        app:activeThumb="@drawable/active_thumb"
        app:inactiveDrawable="@drawable/inactive_tracking_effect"
        app:inactiveThumb="@drawable/inactive_thumb"
        app:trackingEffect="true" />

