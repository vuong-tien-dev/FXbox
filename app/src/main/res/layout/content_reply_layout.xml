    <LinearLayout
        android:id="@+id/bottom_sheet_header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UseCompoundDrawables">
        <ImageView
            android:id="@+id/bottom_sheet_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            app:tint="@color/rgb_240"
            android:gravity="center_vertical"
            android:src="@drawable/search_bar_view_back_icon"
            android:contentDescription="@null">

        </ImageView>
        <TextView
            android:id="@+id/bottom_sheet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gotham_bold"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:text="@string/replies"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp"
            />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/comment_was_replied_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rgb_48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottom_sheet_header_layout"
        app:layout_constraintEnd_toEndOf="parent">
        <include
            android:id="@+id/comment_was_replied_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_gravity="center"
            layout="@layout/comment_item_layout"
            />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/bottom_sheet_list_comment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_was_replied_container">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bottom_sheet_list_comment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.vtstudio.fxbox.fxviews.progressbar.FxLoadingView
            android:id="@+id/bottom_sheet_loading_comment"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/bottom_sheet_comment_is_none_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/bottom_sheet_comment_is_none_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/tiktok_display_medium"
                android:text="@string/replies_is_none"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/bottom_sheet_comment_download_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/try_again_background_drw"
                android:fontFamily="@font/tiktok_display_medium"
                android:gravity="center"
                android:padding="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/download_comments"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>