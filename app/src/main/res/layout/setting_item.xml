<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:background="?selectableItemBackground">


    <ImageView
        android:id="@+id/setting_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="24dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/setting_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting_option"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/setting_option"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.255"
        app:layout_constraintStart_toEndOf="@+id/setting_image"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/setting_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/rgb_84"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@+id/setting_option"
        app:layout_constraintStart_toStartOf="@+id/setting_option"
        app:layout_constraintTop_toBottomOf="@+id/setting_option" />

    <ProgressBar
        android:id="@+id/setting_line"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="100"
        android:progressTint="@color/rgb_48"
        app:layout_constraintEnd_toEndOf="@+id/setting_summary"
        app:layout_constraintStart_toStartOf="@+id/setting_summary"
        app:layout_constraintTop_toBottomOf="@+id/setting_summary" />
</androidx.constraintlayout.widget.ConstraintLayout>